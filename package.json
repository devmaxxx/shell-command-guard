{
  "name": "shell-guards",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "description": "Tell whether a shell command really runs a program — a fail-closed deny-list that sees through quotes, here-documents, $(…), bash -c, env, sudo and xargs",
  "author": "arenuzzz",
  "license": "MIT",
  "homepage": "https://github.com/devmaxxx/shell-guards#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaxxx/shell-guards.git"
  },
  "bugs": {
    "url": "https://github.com/devmaxxx/shell-guards/issues"
  },
  "keywords": [
    "shell",
    "bash",
    "zsh",
    "command",
    "command-parser",
    "security",
    "deny-list",
    "denylist",
    "guard",
    "heredoc",
    "ai-agent",
    "claude-code",
    "pre-tool-use",
    "hook",
    "parser"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "demo": "unrun scripts/demo.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
